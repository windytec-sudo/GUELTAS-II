rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check safe string
    function isNonEmptyString(val) {
      return val is string && val.size() > 0 && val.size() < 5000;
    }

    // Master Data collection: config doc
    match /masterData/{docId} {
      allow read, write: if true;
    }

    // Records collection: órdenes de trabajo
    match /records/{recordId} {
      allow read, write: if true;
    }
  }
}
